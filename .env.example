# ? ********************************* App configuration *********************************
# environment
NODE_APP_ENV=<Environment type> # development | staging | production
# port
NODE_APP_PORT=<port>

# ? ********************************* Database configuration *********************************
# URL
NODE_APP_DATABASE_URL=<connection string>

# ? ********************************* JWT configuration *********************************
# SECRET KEY for signing JWT tokens
NODE_APP_JWT_SECRET=<secret key for JWT>
# Expiration time for access tokens (e.g., 15m for 15 minutes)
NODE_APP_JWT_ACCESS_TOKEN_EXPIRATION=<access token> # 15m, 30m 
# Expiration time for refresh tokens (e.g., 7d for 7 days)
NODE_APP_JWT_REFRESH_TOKEN_EXPIRATION=<refresh token>

# ? ******************************** File Storage configuration ********************************* */
# Root directory for storing uploaded files
NODE_APP_FILES_ROOT=public
# URL for serving uploaded files (e.g., http://localhost:3000)
NODE_APP_FILES_SERVE_URL=http://localhost:4000
# Maximum file size for uploads (in bytes, e.g., 104857600 for 100MB)
NODE_APP_FILES_MAX_SIZE=104857600
# Maximum number of files allowed per upload
NODE_APP_FILES_MAX_FILES=20
# Allowed MIME types for uploaded files (comma-separated list)
NODE_APP_FILES_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv,audio/mpeg,audio/wav,audio/mp4,audio/webm,audio/ogg,video/mp4,video/webm,video/quicktime

# ? ***************************************** SMTP Details ***************************************** */
# host
NODE_APP_SMTP_HOST=<HOST>
# port
NODE_APP_SMTP_PORT=<PORT>
# secure
NODE_APP_SMTP_SECURE=<SECURE>
# user
NODE_APP_SMTP_USER=<USER>
# password
NODE_APP_SMTP_PASS=<PASS>
# reject unauthorized
NODE_APP_SMTP_REJECT_UNAUTHORIZED=<REJECT_UNAUTHORIZED>
# protocol
NODE_APP_SMTP_PROTOCOL=<PROTOCOL>
# email from
NODE_APP_SMTP_MAIL_FROM=<MAIL_FROM>
# name from
NODE_APP_SMTP_MAIL_FROM_NAME=<MAIL_FROM_NAME>
